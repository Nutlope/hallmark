{
  "name": "hallmark",
  "owner": {
    "name": "Nutlope",
    "url": "https://github.com/Nutlope"
  },
  "metadata": {
    "description": "Hallmark, the design skill that ends AI slop."
  },
  "plugins": [
    {
      "name": "hallmark",
      "source": "./skills",
      "strict": false,
      "skills": [
        "./hallmark"
      ],
      "hooks": {
        "PostToolUse": [
          {
            "matcher": "Write|Edit|MultiEdit",
            "hooks": [
              {
                "type": "command",
                "command": "node \"${CLAUDE_PLUGIN_ROOT}/hallmark/scripts/lint-hook.mjs\"",
                "timeout": 10
              }
            ]
          }
        ]
      },
      "description": "A design skill for Claude Code, Codex, Cursor and OpenCode that refuses to look AI-generated. Powered by Together AI.",
      "version": "2.0.0",
      "author": {
        "name": "Nutlope",
        "url": "https://github.com/Nutlope"
      },
      "homepage": "https://www.usehallmark.com",
      "repository": "https://github.com/Nutlope/hallmark",
      "license": "MIT",
      "category": "design"
    }
  ]
}
